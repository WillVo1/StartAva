<+><!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Voice Chat - Nurse Ava</title>\n    <link rel=\"icon\" href=\"https://fav.farm/\uD83E\uDDA6\">\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n\n    <script src=\"https://unpkg.com/react@18/umd/react.development.js\" crossorigin></script>\n    <script src=\"https://unpkg.com/react-dom@18/umd/react-dom.development.js\" crossorigin></script>\n\n    <script src=\"https://unpkg.com/@babel/standalone/babel.min.js\"></script>\n\n    <style>\n        body { margin: 0; font-family: system-ui, -apple-system, sans-serif; background: #F7F9F8; }\n    </style>\n</head>\n<body>\n<div id=\"root\"></div>\n\n<script type=\"text/babel\">\n    const { useState, useEffect, useRef } = React;\n\n    /** --- ICONS (Replacing lucide-react for standalone HTML) --- */\n    const Icon = ({ children, size = 24, className = \"\" }) => (\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width={size} height={size} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className={className}>\n            {children}\n        </svg>\n    );\n    const MicIcon = ({ size, className }) => <Icon size={size} className={className}><path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z\"/><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"/><line x1=\"12\" x2=\"12\" y1=\"19\" y2=\"22\"/></Icon>;\n    const SquareIcon = ({ size, className, fill }) => <Icon size={size} className={className}><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\" ry=\"2\" fill={fill || \"none\"}/></Icon>;\n    const PhoneCallIcon = ({ size, className }) => <Icon size={size} className={className}><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/><path d=\"M14.05 2a9 9 0 0 1 8 7.94\"/><path d=\"M14.05 6A5 5 0 0 1 18 10\"/></Icon>;\n    const ActivityIcon = ({ size, className }) => <Icon size={size} className={className}><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></Icon>;\n    const HeartIcon = ({ size, className, fill }) => <Icon size={size} className={className}><path fill={fill || \"none\"} d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"/></Icon>;\n    const MessageSquareIcon = ({ size, className }) => <Icon size={size} className={className}><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></Icon>;\n    const SettingsIcon = ({ size, className }) => <Icon size={size} className={className}><path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></Icon>;\n    const Volume2Icon = ({ size, className }) => <Icon size={size} className={className}><polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"/><path d=\"M15.54 8.46a5 5 0 0 1 0 7.07\"/><path d=\"M19.07 4.93a10 10 0 0 1 0 14.14\"/></Icon>;\n\n    /** --- CONFIGURATION --- */\n    const MODEL = 'gpt-4o-realtime-preview-2024-12-17';\n\n    /** --- COMPONENT: PulseOrb --- */\n    const PulseOrb = ({ isActive, isSpeaking, micLevel }) => {\n        const avaImage = \"nurseavalogo.png\";\n        const dynamicScale = isActive ? 1.25 + (micLevel / 400) : 1;\n        const dynamicOpacity = isActive ? 0.3 + (micLevel / 500) : 0.05;\n\n        return (\n            <div className=\"relative flex items-center justify-center my-10\">\n                <div\n                    className={`absolute w-72 h-72 rounded-full blur-3xl transition-all duration-75 ${isSpeaking ? 'bg-blue-400' : 'bg-emerald-400'}`}\n                    style={{ transform: `scale(${dynamicScale})`, opacity: dynamicOpacity }}\n                />\n\n                <div className={`relative w-48 h-48 rounded-full border-4 border-white shadow-2xl overflow-hidden z-10 transition-transform duration-500 ${isSpeaking ? 'scale-105 border-emerald-100' : 'scale-100'}`}>\n                    <img src={avaImage} className=\"w-full h-full object-cover scale-110\" alt=\"Nurse Ava\" />\n\n                    {(isActive) && (\n                        <div className=\"absolute inset-0 bg-emerald-900/40 flex items-center justify-center backdrop-blur-[2px] transition-all\">\n                            <div className=\"flex gap-1.5 items-end h-10\">\n                                {[1, 1.5, 2, 1.5, 1].map((multiplier, i) => (\n                                    <div\n                                        key={i}\n                                        className=\"w-1.5 bg-white rounded-full transition-all duration-75\"\n                                        style={{ height: `${Math.max(4, (micLevel / 3) * multiplier)}px`, opacity: 0.8 + (micLevel / 500) }}\n                                    />\n                                ))}\n                            </div>\n                        </div>\n                    )}\n                </div>\n                <div className=\"absolute w-80 h-80 border border-emerald-200/30 rounded-full border-dashed animate-[spin_20s_linear_infinite]\" />\n            </div>\n        );\n    };\n\n    /** --- MAIN APP COMPONENT --- */\n    function NurseAvaApp() {\n        const [messages, setMessages] = useState([]);\n        const [showChat, setShowChat] = useState(false);\n        const [isEmergency, setIsEmergency] = useState(false);\n        const [status, setStatus] = useState(\"Ready for Check-in\");\n        const [isConnected, setIsConnected] = useState(false);\n        const [micLevel, setMicLevel] = useState(0);\n\n        const pcRef = useRef(null);\n        const dcRef = useRef(null);\n        const mcpToolsRef = useRef([]);\n        const audioCtxRef = useRef(null);\n        const analyserRef = useRef(null);\n        const animationFrameRef = useRef(null);\n\n        useEffect(() => {\n            fetch('/api/mcp-tools')\n                .then(r => r.json())\n                .then(tools => { mcpToolsRef.current = tools; })\n                .catch(e => console.warn(\"Could not load MCP tools. Make sure your local server is running.\", e));\n        }, []);\n\n        const updateMicLevel = () => {\n            if (!analyserRef.current) return;\n            const dataArray = new Uint8Array(analyserRef.current.frequencyBinCount);\n            analyserRef.current.getByteFrequencyData(dataArray);\n            const average = dataArray.reduce((acc, val) => acc + val, 0) / dataArray.length;\n            setMicLevel(average);\n            animationFrameRef.current = requestAnimationFrame(updateMicLevel);\n        };\n\n        const stopSession = () => {\n            if (pcRef.current) {\n                pcRef.current.close();\n                pcRef.current = null;\n            }\n            if (animationFrameRef.current) cancelAnimationFrame(animationFrameRef.current);\n            if (audioCtxRef.current) {\n                audioCtxRef.current.close();\n                audioCtxRef.current = null;\n            }\n            setMicLevel(0);\n            setIsConnected(false);\n            setStatus(\"Session Ended\");\n        };\n\n        const startSession = async () => {\n            try {\n                setStatus(\"Connecting...\");\n                const { key } = await fetch('/api/key').then(r => r.json());\n\n                const tokenRes = await fetch('https://api.openai.com/v1/realtime/sessions', {\n                    method: 'POST',\n                    headers: { 'Authorization': `Bearer ${key}`, 'Content-Type': 'application/json' },\n                    body: JSON.stringify({ model: MODEL, voice: 'sage' })\n                }).then(r => r.json());\n\n                const pc = new RTCPeerConnection();\n                pcRef.current = pc;\n\n                pc.ontrack = e => {\n                    const audio = new Audio();\n                    audio.srcObject = e.streams[0];\n                    audio.play();\n                    setStatus(\"Nurse Ava is Active\");\n                };\n\n                const ms = await navigator.mediaDevices.getUserMedia({ audio: true });\n                pc.addTrack(ms.getTracks()[0]);\n\n                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n                audioCtxRef.current = audioCtx;\n                const analyser = audioCtx.createAnalyser();\n                analyser.fftSize = 256;\n                analyserRef.current = analyser;\n\n                const source = audioCtx.createMediaStreamSource(ms);\n                source.connect(analyser);\n                updateMicLevel();\n\n                const dc = pc.createDataChannel('oai-events');\n                dcRef.current = dc;\n\n                dc.onopen = () => {\n                    setIsConnected(true);\n                    dc.send(JSON.stringify({\n                        type: 'session.update',\n                        session: {\n                            instructions: `You are Nurse Ava, a helpful medical assistant. Be EXTREMELY human, concise, and AVOID BEING ROBOTIC in all responses.\nWhen you first greet the patient say this -> Hey, I know it’s been 45 minutes, how are you feeling? Did your stomach pain get better?\nIf patient ask about results/what stage they are on. STRICTLY only use what is given from ehrRetrievaltool\nPatients ONLY AFTER can be seen after 1-2 hours (ONLY GIVE UNTIL USER ASK)\nCurrent patient: John (Subject ID: 10023239, Stay ID: 39348852).\nInjury: stomach Injury\nVitals:\n- Temperature: 97.8°F\n- Heart Rate: 115 bpm\n- Respiratory Rate: 20\n- O2 Saturation: 99%\n- Blood Pressure: 92/42 mmHg\n- Pain Level: 0/10\n- Acuity Level: 2\nChief Complaint: stomach Pain.\nInstructions:\n- When patient reports emergencies, use notify_nurse_emergency tool with +18047297894\n- Use ehrRetrievalTool when user asks for updates on their treatment\n- Use medicalBookRAGTool for general medical advice.`,\n                            tools: mcpToolsRef.current\n                        }\n                    }));\n                };\n\n                dc.onmessage = async (e) => {\n                    const event = JSON.parse(e.data);\n\n                    if (event.type === 'response.function_call_arguments.done') {\n                        console.log('Function call:', event.name, event.arguments);\n                        if (event.name === 'notify_nurse_emergency') setIsEmergency(true);\n\n                        const result = await fetch('/api/mcp-call', {\n                            method: 'POST',\n                            headers: { 'Content-Type': 'application/json' },\n                            body: JSON.stringify({ name: event.name, arguments: JSON.parse(event.arguments) })\n                        }).then(r => r.json());\n\n                        dc.send(JSON.stringify({\n                            type: 'conversation.item.create',\n                            item: { type: 'function_call_output', call_id: event.call_id, output: JSON.stringify(result) }\n                        }));\n                        dc.send(JSON.stringify({ type: 'response.create' }));\n                    }\n\n                    if (event.type === 'response.audio_transcript.done') {\n                        setMessages(prev => [...prev, { role: 'bot', text: event.transcript }]);\n                    }\n                };\n\n                const offer = await pc.createOffer();\n                await pc.setLocalDescription(offer);\n\n                const answerSdp = await fetch(`https://api.openai.com/v1/realtime?model=${MODEL}`, {\n                    method: 'POST',\n                    headers: {\n                        'Authorization': `Bearer ${tokenRes.client_secret.value}`,\n                        'Content-Type': 'application/sdp'\n                    },\n                    body: offer.sdp\n                }).then(r => r.text());\n\n                await pc.setRemoteDescription({ type: 'answer', sdp: answerSdp });\n\n            } catch (err) {\n                console.error(err);\n                setStatus(\"Connection Error. Check console.\");\n                stopSession();\n            }\n        };\n\n        if (isEmergency) {\n            return (\n                <div className=\"fixed inset-0 bg-red-600 flex flex-col items-center justify-center text-white p-12 text-center z-[100]\">\n                    <div className=\"w-20 h-20 bg-white/20 rounded-full flex items-center justify-center mb-6 animate-bounce\">\n                        <PhoneCallIcon size={40} />\n                    </div>\n                    <h1 className=\"text-5xl font-black mb-4 uppercase tracking-tighter\">Help is Coming</h1>\n                    <p className=\"text-xl opacity-90 mb-10 max-w-md\">The emergency alert has been sent. A nurse is reviewing your history now.</p>\n                    <button onClick={() => window.location.reload()} className=\"bg-white text-red-600 px-10 py-4 rounded-full font-bold shadow-xl\">DISMISS ALERT</button>\n                </div>\n            );\n        }\n\n        return (\n            <div className=\"min-h-screen bg-[#F7F9F8] flex flex-col items-center p-8 text-slate-900\">\n                <header className=\"flex flex-col items-center gap-2 mt-6 mb-2\">\n                    <div className=\"flex items-center gap-2 px-3 py-1 bg-emerald-50 text-emerald-600 rounded-full border border-emerald-100\">\n                        <ActivityIcon size={12} className=\"animate-pulse\" />\n                        <span className=\"text-[10px] font-bold uppercase tracking-widest italic flex items-center gap-1\">\n                                <HeartIcon size={10} fill=\"currentColor\" /> Ava Online\n                            </span>\n                    </div>\n                    <h1 className=\"text-4xl font-black tracking-tight text-slate-900\">Nurse Ava</h1>\n                    <p className={`text-sm font-medium transition-colors duration-300 ${isConnected ? 'text-emerald-600' : 'text-slate-400'}`}>\n                        {status}\n                    </p>\n                </header>\n\n                <main className=\"flex-1 flex flex-col items-center justify-center w-full\">\n                    <PulseOrb isActive={isConnected} isSpeaking={false} micLevel={micLevel} />\n\n                    <div className=\"mt-8 w-full max-w-sm px-4\">\n                        <button\n                            onClick={isConnected ? stopSession : startSession}\n                            className={`w-full flex items-center justify-between gap-4 px-8 py-5 rounded-3xl shadow-xl transition-all active:scale-[0.98] border-2\n                                ${isConnected ? 'bg-red-50 border-red-200 text-red-600' : 'bg-white border-slate-100 text-slate-800 shadow-emerald-900/5 hover:border-emerald-200'}`}\n                        >\n                            <div className=\"flex flex-col items-start text-left\">\n                                <span className=\"font-extrabold text-lg leading-tight\">{isConnected ? \"Stop Chat\" : \"Start Check-in\"}</span>\n                                <span className=\"text-[10px] uppercase opacity-50 tracking-widest font-bold\">{isConnected ? \"Live Now\" : \"Voice Active\"}</span>\n                            </div>\n                            <div className={`p-4 rounded-2xl ${isConnected ? 'bg-red-600' : 'bg-emerald-600'} text-white shadow-lg`}>\n                                {isConnected ? <SquareIcon size={20} fill=\"currentColor\" /> : <MicIcon size={20} />}\n                            </div>\n                        </button>\n                    </div>\n                </main>\n\n                <footer className=\"mt-8 flex flex-col items-center gap-6 pb-6\">\n                    <button onClick={() => setShowChat(true)} className=\"flex items-center gap-2 text-sm font-bold text-emerald-600 hover:text-emerald-800 transition-colors\">\n                        <MessageSquareIcon size={16} /> Switch to text logs\n                    </button>\n                    <div className=\"flex gap-10 text-slate-300\">\n                        <SettingsIcon size={22} className=\"hover:text-emerald-500 cursor-pointer transition-colors\" />\n                        <Volume2Icon size={22} className=\"hover:text-emerald-500 cursor-pointer transition-colors\" />\n                    </div>\n                </footer>\n            </div>\n        );\n    }\n\n    const root = ReactDOM.createRoot(document.getElementById('root'));\n    root.render(<NurseAvaApp />);\n</script>\n</body>\n</html>\n
